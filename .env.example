# =============================================================================
# Theoros — environment variables
#
# Copy this file to .env and fill in the real values. The .env file is
# gitignored; this template is safe to commit.
# =============================================================================

# -----------------------------------------------------------------------------
# Claude API (Phase 4+: daily/weekly/monthly reflections, on-demand queries)
# Get your key at https://console.anthropic.com/
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your-key-here

# -----------------------------------------------------------------------------
# Voyage AI embeddings (voyage-4-large, 1024 dimensions)
# Used to embed normalized records, session summaries, reflections,
# observations, and theme versions into Supabase pgvector.
# Get your key at https://dash.voyageai.com/
# -----------------------------------------------------------------------------
VOYAGE_API_KEY=your-key-here

# -----------------------------------------------------------------------------
# Supabase
# Found in your Supabase project: Settings → API.
# -----------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=your-project-url-here

# Service role key — full access, bypasses RLS. Used by the local capture
# service and promotion pipeline to write summaries, reflections, and
# embeddings. Never expose this to client-side code.
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Anon key — respects RLS. Used by read-side code (e.g. the phone-accessible
# reading surface in Phase 5).
SUPABASE_ANON_KEY=your-anon-key-here

# -----------------------------------------------------------------------------
# Local services
# -----------------------------------------------------------------------------

# URL of the local LLM server (llama.cpp or compatible). Used for
# session summaries, topic/entity extraction, and other high-frequency
# evidence work (Phase 3+). A single GPU means one llama-server
# instance; if you share a local model server with other projects on
# the same machine, all of them talk to the same endpoint.
THEOROS_LLM_URL=http://127.0.0.1:8000

# Path to the local SQLite database. Relative paths resolve from the
# project root. The default puts it inside the gitignored memory/
# directory.
THEOROS_DB_PATH=memory/system/theoros.db

# Path to the operator-identity block injected into the distillation
# prompt. Kept in the gitignored memory/ tree so real names and handles
# never enter version control. A sanitized template lives at
# docs/operator_identity.example.txt — copy it to the path below and
# fill in the operator's real aliases. If the file is missing, the
# distillation worker falls back to a generic first-person rule.
THEOROS_OPERATOR_IDENTITY_PATH=memory/system/operator_identity.txt

# Capture service (Phase 2a). Binds to localhost only — never expose
# to the network.
THEOROS_CAPTURE_HOST=127.0.0.1
THEOROS_CAPTURE_PORT=8765

# Reader service (Phase 5). Phone-friendly view of promoted reflections.
# Binds to localhost; exposed to the internet via the cloudflared tunnel
# on its own hostname (e.g. reflections.example.com).
THEOROS_READER_HOST=127.0.0.1
THEOROS_READER_PORT=8766

# Cloudflare Access application AUD for the reader's hostname. Different
# from the capture AUD because the reader lives on its own hostname with
# a user-login policy (not a service-token policy). Pull this from the
# Cf-Access-Aud header after creating the Access application. Leave
# empty to disable auth for local development.
THEOROS_READER_CF_AUD=

# Email address the reader accepts. Should match the identity Cloudflare
# Access authenticates you with (Google / GitHub login). Enforced at the
# origin as defense-in-depth over the Access policy itself.
THEOROS_READER_ALLOWED_EMAIL=

# -----------------------------------------------------------------------------
# Cloudflare Access (optional — leave empty to disable and run local-only)
# -----------------------------------------------------------------------------

# Cloudflare Zero Trust team domain. Same string that appears in the
# Access login URL, e.g. yourteam.cloudflareaccess.com.
THEOROS_CF_TEAM_DOMAIN=
THEOROS_READER_CF_TEAM_DOMAIN=

# Cloudflare Access application AUD for the capture app. Pull this from
# the Cf-Access-Aud header after creating the Access application.
THEOROS_CF_AUD=

# Cloudflare Access service-token Client-ID expected on inbound capture
# requests. When set, the CF-Access-Client-Id header must match.
THEOROS_CF_ACCESS_CLIENT_ID=
